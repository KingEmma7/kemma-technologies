# Required to send enquiries in development and production. Without a key,
# the API returns 503 and the form shows an error instead of claiming delivery.
RESEND_API_KEY=re_xxxxxxxxxx

# Canonical production origin. Drives metadataBase, canonical URLs, sitemap.xml,
# robots.txt and Open Graph / Twitter preview URLs.
#
# Production: https://www.kemmatechnologies.com (the default in lib/site.ts and
# the host that currently serves the site; the apex redirects here).
# Preview deploys: set this to the preview's own URL, otherwise previews emit
# canonicals pointing at production and can get indexed in its place.
NEXT_PUBLIC_SITE_URL=https://www.kemmatechnologies.com

# Optional. Branded "from" address for enquiry emails, e.g.
#   "Kemma Website <noreply@kemmatechnologies.com>"
# Requires kemmatechnologies.com to be a verified domain in Resend. If unset,
# the form falls back to Resend's shared sandbox sender (onboarding@resend.dev).
CONTACT_FROM_EMAIL=

# Optional server-only inbox for crochet brief notifications. Blank uses SITE.email.
# Set one valid working mailbox; this never changes the public website contact.
# The first saved email payload keeps its recipient even if this setting changes.
BRIEF_TO_EMAIL=

# Crochet brief: private Cloudflare Worker/R2 gateway and capability signing.
# HTTPS Worker origin only; no path, query or trailing upload endpoint.
BRIEF_STORAGE_URL=
# Separate random server-only value of at least 32 characters, mirrored in Worker.
# Must differ from BRIEF_SIGNING_SECRET. Never expose it as NEXT_PUBLIC_.
BRIEF_STORAGE_SECRET=
BRIEF_SIGNING_SECRET=
# Private short links: JSON mapping SHA-256(code) to {"id":"UUID","exp":epoch_ms}.
# Register generated entries before sharing /b/<code>. Never use NEXT_PUBLIC_.
BRIEF_SHORT_LINKS=
CRON_SECRET=

# Local preview ONLY; never set these in deployed environments.
# BRIEF_STORAGE_MODE=local
# BRIEF_PREVIEW_INVITE=
# BRIEF_EMAIL_MODE=preview
