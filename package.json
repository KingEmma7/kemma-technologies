{
  "name": "kemma-website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "tooling/next-root-glob"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:no-js": "node scripts/check-no-js.mjs",
    "check": "npm run lint && npm run test:lint-tooling && npm run typecheck && npm run test && npm run check:brief-worker && npm run build && npm run check:no-js && npm run check:demos && npm run check:editorial",
    "test:lint-tooling": "node --test tests/lint-tooling.test.mjs",
    "demos:import": "node scripts/import-demos.mjs",
    "check:demos": "node scripts/check-demos.mjs",
    "check:editorial": "node scripts/check-editorial.mjs",
    "check:brief-worker": "npm --prefix worker/brief-storage run typecheck && npm --prefix worker/brief-storage test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-three/fiber": "9.8.2",
    "framer-motion": "^12.42.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.80.0",
    "resend": "^6.14.0",
    "three": "^0.185.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vinext/cloudflare": "^1.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-glob": "file:tooling/next-root-glob",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.4.6",
    "vite": "^8.3.8",
    "vite-css-modules": "^1.9.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vite-plugin-dynamic-import": {
      "fast-glob": "file:tooling/next-root-glob"
    },
    "@next/eslint-plugin-next@16.4.6": {
      "fast-glob": "$fast-glob"
    }
  },
  "type": "module"
}
